{
  "[bibtex]": {
    "editor.formatOnSave": false
  },
  "[git-commit]": {
    "editor.rulers": [72],
    "rewrap.wrappingColumn": 72
  },
  "[json]": {
    "editor.wordWrap": "on"
  },
  "[json][jsonc][markdown][quarto][snippets][yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  "cSpell.enabled": true,
  "diffEditor.experimental.showMoves": true,
  "editor.formatOnSave": true,
  "git.rebaseWhenSync": true,
  "github-actions.workflows.pinned.workflows": [".github/workflows/ci.yml"],
  "gitlens.telemetry.enabled": false,
  "livePreview.defaultPreviewPath": "_build/html",
  "prettier.documentSelectors": ["**/*.qmd"],
  "quarto.path": ".venv/bin/quarto",
  "quarto.render.renderOnSave": true,
  "redhat.telemetry.enabled": false,
  "rewrap.wrappingColumn": 88,
  "search.exclude": {
    "**/uv.lock": true
  },
  "telemetry.telemetryLevel": "off"
}
